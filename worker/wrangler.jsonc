{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "norda-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-07",
  "workers_dev": true,
  "triggers": {
    "crons": ["*/5 * * * *", "0 3 * * *"]
  },
  "vars": {
    "ALLOWED_ORIGINS": "https://version-3y3.pages.dev,http://localhost:5174"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "norda-db",
      "database_id": "e78b1da3-8341-4639-865d-e62825e4b7ca",
      "migrations_dir": "migrations"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "REPLIES",
      "id": "b2f2b4acd42348b7bb207ed69851e175"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TICKETS",
        "class_name": "TicketsDurableObject"
      }
    ]
  },
  "exports": {
    "TicketsDurableObject": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
