# NorDa — Environment Configuration
# Copy to .env and adjust. All defaults are safe for LOCAL DEMO.

# Runtime
NODE_ENV=development
API_PORT=4000
WEB_PORT=5173
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173

# Database (relative to API package root)
DATABASE_URL=file:./data/norda.sqlite

# Sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=dev-only-replace-with-32-byte-base64-secret
SESSION_COOKIE_NAME=norda_sid
SESSION_IDLE_TTL_HOURS=168
SESSION_ABSOLUTE_TTL_HOURS=720

# Bootstrap first-run admin
BOOTSTRAP_ENABLED=true

# Demo seeding
SEED_DEMO_DATA=true
SEED_DEV_ADMIN=true

# Currency / exchange
DEFAULT_EXCHANGE_RATE_DZD_PER_USD=250

# PayPal (demo | sandbox | live)
PAYPAL_MODE=demo
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_API_BASE=https://api-m.sandbox.paypal.com

# BaridiMob (manual proof workflow)
BARIDIMOB_MODE=demo
BARIDIMOB_ACCOUNT_NAME=NorDa Demo Account
BARIDIMOB_ACCOUNT_NUMBER=0000000000000000
BARIDIMOB_BANK_NAME=Algérie Poste (demo)

# GGSoma provider adapter — never expose key to the web bundle
GGSOMA_MODE=demo
GGSOMA_API_KEY=
GGSOMA_API_BASE=https://api.ggsoma.example/v1
GGSOMA_SYNC_INTERVAL_MINUTES=60

# AI support adapter
AI_PROVIDER=rule-based
AI_OPENAI_API_KEY=
AI_OPENAI_MODEL=gpt-4o-mini

# Email
EMAIL_TRANSPORT=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="NorDa <noreply@localhost>"

# Uploads
UPLOAD_DIR=./storage/uploads
UPLOAD_MAX_BYTES=5242880
